# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only media (pro/tour clips are not redistributable; keep them on disk only)
/public/pro-swings/

# third-party reference screenshots (kept locally for design reference only)
/DesignIdeas/*.png

# raw source clips for scripts/prepare-sample.sh (not committed)
/raw-samples/

# MediaPipe wasm runtime, copied from node_modules by scripts/copy-mediapipe-wasm.mjs
/public/mediapipe/wasm/

# local AI tooling state (not part of the app)
/.agents/
/.impeccable/
/skills-lock.json
